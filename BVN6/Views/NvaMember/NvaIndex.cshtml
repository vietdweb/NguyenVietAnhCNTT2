
@model IEnumerable<BVN6.Models.NvaMember>

@{
    ViewData["Title"] = "NvaIndex";
}

<h1>NvaIndex</h1>

<p>
    <a asp-action="NvaCreate">Create New</a>
</p>
<table class="table">
