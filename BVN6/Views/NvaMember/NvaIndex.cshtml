                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NvaMemberFullName)
                </td>
                <td>
                    @Html.ActionLink("Sửa", "NvaEdit", new { id = item.NvaMemberId }) |
                    @Html.ActionLink("NvaDetails", "NvaGetDetails", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("NvaDelete", "NvaDelete", new { /* id=item.PrimaryKey */ })
                </td>
