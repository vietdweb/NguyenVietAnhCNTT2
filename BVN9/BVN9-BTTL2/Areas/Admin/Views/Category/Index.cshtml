@model IEnumerable<Category>
@{ ViewData["Title"] = "Category"; }
<div class="d-flex justify-content-between align-items-center"><h1>Category</h1><a class="btn btn-primary" asp-action="Create">Thêm danh mục</a></div>
<table class="table table-bordered table-striped mt-3"><thead><tr><th>Id</th><th>Name</th><th>Status</th><th>Created date</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.Name</td><td>@(item.Status == 1 ? "Hiện" : "Ẩn")</td><td>@item.CreatedDate.ToString("dd/MM/yyyy")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> | <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a></td></tr> }
</tbody></table>
