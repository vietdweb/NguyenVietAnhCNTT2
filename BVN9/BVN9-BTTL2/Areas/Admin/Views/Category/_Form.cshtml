@model Category
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden" />
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option value="1">Hiện</option><option value="0">Ẩn</option></select></div>
<div class="mb-3"><label asp-for="CreatedDate" class="form-label"></label><input asp-for="CreatedDate" type="date" class="form-control" /></div>
