@model IEnumerable<Product>
@{ ViewData["Title"] = "Product"; }
<div class="d-flex justify-content-between align-items-center"><h1>Product</h1><a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a></div>
<table class="table table-bordered table-striped mt-3"><thead><tr><th>Id</th><th>Name</th><th>Category</th><th>Price</th><th>Sale price</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Category?.Name</td><td>@item.Price</td><td>@item.SalePrice</td><td>@(item.Status == 1 ? "Hiện" : "Ẩn")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> | <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a></td></tr> }
</tbody></table>
