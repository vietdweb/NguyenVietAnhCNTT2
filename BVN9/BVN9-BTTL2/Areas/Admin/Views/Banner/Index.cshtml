@model IEnumerable<Banner>
@{ ViewData["Title"] = "Banner"; }
<div class="d-flex justify-content-between align-items-center"><h1>Banner</h1><a class="btn btn-primary" asp-action="Create">Thêm banner</a></div>
<table class="table table-bordered table-striped mt-3"><thead><tr><th>Id</th><th>Name</th><th>Priority</th><th>Status</th><th>Image</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Priority</td><td>@(item.Status == 1 ? "Hiện" : "Ẩn")</td><td>@item.Image</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> | <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a></td></tr> }
</tbody></table>
