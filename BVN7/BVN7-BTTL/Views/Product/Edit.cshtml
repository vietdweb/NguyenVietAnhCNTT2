@model BVN7_BTTL.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<h1>Sửa sản phẩm</h1>

<form asp-action="Edit"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Ảnh mới</label>
        <input type="file"
               name="imageFile"
               class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price"
               type="number"
               class="form-control" />
        <span asp-validation-for="Price"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="SalePrice"></label>
        <input asp-for="SalePrice"
               type="number"
               class="form-control" />
        <span asp-validation-for="SalePrice"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CategoryId"></label>

        <select asp-for="CategoryId"
                asp-items="ViewBag.CategoryId"
                class="form-control">
        </select>

        <span asp-validation-for="CategoryId"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description"
                  class="form-control"></textarea>

        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Lưu thay đổi
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}